Options -Indexes

# Redirection non-www → www, sauf pour la home (pour permettre la vérif Meta)
RewriteEngine On
RewriteCond %{HTTP_HOST} ^neuro-odyssee\.com$ [NC]
RewriteCond %{REQUEST_URI} !^/$
RewriteRule ^(.*)$ https://www.neuro-odyssee.com/$1 [R=301,L]

# En-têtes de sécurité
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

  # Fichiers de langue/données : revalider à chaque fois (sinon traductions périmées en cache navigateur)
  <FilesMatch "\.json$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Scripts, styles et pages : même raison. Sans ça, un visiteur déjà venu
  # garde l'ancien js/map.js après un déploiement et voit une carte périmée
  # (compteur figé à 0). « no-cache » ne désactive pas le cache : il force
  # une revalidation, donc un 304 tant que le fichier n'a pas changé.
  <FilesMatch "\.(js|css|html)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# Bloquer l'accès public aux journaux (.log)
<FilesMatch "\.log$">
  Require all denied
</FilesMatch>
